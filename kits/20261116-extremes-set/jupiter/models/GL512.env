# Model file of the extremes set XSET-1: GL512 = db_global_512_300k (10 surface outputs), the reference model.
# A model file names what does not change between the exports of one run: run directory, config, code tree and pins.
# Sourced by xset_runs.sh after CK and DEVR are set. One file per model; an export of it is given to xset_row.sh by step.
MODEL_NAME=db_global_512_300k
RUN_DIR=$CK/checkpoint_nm50_global/db_global_512_300k
CFG_DIR=$DEVR/db_global_20261027/configs
CFG_NAME=db_global_512_300k
EXPECT_CODE=db_global_20261027/code/anemoi-core
CODE_ROOT=/e/data1/jureap-data/ecmwf/users/jdumont/db_global_20261027/code/anemoi-core
CODE_SHA_FILE=$DEVR/db_global_20261027/CODE_PIN
DATASETS_SHA_FILE=$DEVR/db_global_20261027/DATASETS_PIN

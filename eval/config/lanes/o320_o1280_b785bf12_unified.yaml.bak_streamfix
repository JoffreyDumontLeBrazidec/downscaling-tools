lineage: plus-halo
# o320->o1280 UNIFIED smoke lane — drives the multi-ds-unified Jupiter ckpt b785bf12
# through eval.cli -> prepml 0.99 -> anemoi-inference (UnifiedDownscalingRunner) on ac.
# Mirrors o320_o1280.yaml but: (a) allows atos_ac_unified for prepare/predict (the lane
# is empirically ac-capable; the [atos_ag] lock is an eval-harness convenience), (b) emits
# base_runner=downscaling_unified, (c) targets gpu_debug/--qos=dg (30-min cap, idle nodes),
# (d) trimmed to a 2-member / 2-step / 1-date proof. Runner.venv is supplied at the CLI via
# --prepml-runner (ds-260612-prepml-wrap). Evaluation surface (tc/spectra/...) is inherited
# but unused for the run+fdb_write proof.
default_host: atos_ac_unified
allowed_hosts:
  prepare: [atos_ac_unified, atos_ag]
  predict: [atos_ac_unified, atos_ag]
  run: []
  evaluate: [atos_ac]
  scoreboard: [atos_ac]

prepare:
  bundle_filename_tpl: "eefo_o320_0001_date{date}_time0000_mem{member:02d}_step{step:03d}h_input_bundle.nc"
  args:
    lres_sfc_grib:   "{source_grib_root}/eefo_o320_0001_date{date}_time0000_mem1to10_step24to120_sfc.grib"
    lres_pl_grib:    "{source_grib_root}/eefo_o320_0001_date{date}_time0000_mem1to10_step24to120_pl.grib"
    hres_grib:       "{source_grib_root}/enfo_o1280_0001_date{date}_time0000_step24to120_sfc.grib"
    target_sfc_grib: "{source_grib_root}/enfo_o1280_0001_date{date}_time0000_mem1to10_step24to120_sfc_y.grib"
    target_pl_grib:  "{source_grib_root}/enfo_o1280_0001_date{date}_time0000_mem1to10_step24to120_pl_y.grib"

predict:
  members: [1, 2]
  steps: [24]
  dates: ["20230826"]
  num_gpus_per_model: 8
  env:
    ANEMOI_INFERENCE_NUM_CHUNKS: 32
    ANEMOI_INFERENCE_NUM_CHUNKS_PROCESSOR: 32
    ANEMOI_INFERENCE_NUM_CHUNKS_MAPPER: 32
    PYTORCH_CUDA_ALLOC_CONF: "expandable_segments:True"
    CODEX_UNIFIED_SHARD_STRATEGY: edges
  sampler:
    schedule_type: "experimental_piecewise"
    num_steps: 30
    sigma_max: 10000.0
    sigma_transition: 10.0
    sigma_min: 0.03
    high_schedule_type: "exponential"
    low_schedule_type: "karras"
    num_steps_high: 10
    num_steps_low: 20
    rho: 7.0
    sampler: "heun"
    S_churn: 2.5
    S_min: 0.75
    S_max: 10000.0
    S_noise: 1.05

spectra:
  fields: ["10u", "10v", "2t", "msl", "t_850", "z_500"]

# Required by the lane validator; unused for the run+fdb_write proof (no evaluate stage).
evaluator_groups:
  default: []
  diagnostics: []

prepml:
  debug_expvers: ["j5ya"]
  runner: anemoi-dev
  base_runner: downscaling_unified
  venv: /home/ecm5702/hpcperm/lineages/plus-halo/prepml-wrap
  input:
    class: od
    stream: enfo
    type: pf
    grid: O320
  output:
    class: rd
    stream: enfo
    type: pf
  output_template: /home/ecm5702/hpcperm/data/o1280-template.grib
  forcings_npz: /home/ecm5702/hpcperm/data/o1280-forcings.npz
  constant_high_res_forcings:
    - cos_latitude
    - cos_longitude
    - lsm
    - sin_latitude
    - sin_longitude
    - z
  high_res_input:
    - cos_julian_day
    - cos_latitude
    - cos_local_time
    - cos_longitude
    - insolation
    - lsm
    - sin_julian_day
    - sin_latitude
    - sin_local_time
    - sin_longitude
    - z
  truth:
    root: /home/ecm5702/perm/reference/o320_o1280
  time_step: 24h
  lead_time: 240h
  platform:
    gpu:
      time: "0-00:30"
      submit_arguments:
        total_nodes: 2
        tasks_per_node: 4
        gpus_per_node: 4
        partition: gpu_debug
        RAW_PRAGMA:
          - "#SBATCH --gres=gpu:4"
          - "#SBATCH --qos=dg"
          - "#SBATCH --mem=0"

resource_profiles:
  predict:
    qos: dg
    gpus: 4
    ntasks_per_node: 4
    time: "00:30:00"
    mem: "0"
    cpus: 8

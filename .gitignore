__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Editor / backup files
*.bak
*.bak[._-]*
*.swp
*~

# Job submission logs (created by ecsbatch wrapper when sbatch is run from repo root)
ecsbatch.log.*
*.out
# Core dumps are named core.<pid> or core.<host>.<pid>. The pattern is narrow on purpose:
# a plain core.* would also hide a source file called core.py.
core.[0-9]*
core.*.[0-9]*

# Legacy generated eval scripts (new flow writes under /home/ecm5702/perm/eval/<run>/jobs)
eval/jobs/generated/

# Generated lane variants (eval/jobs/ladder.py::derive_lane materialises these
# from eval/config/ladder/*.yaml profiles; never hand-edit, never commit).
eval/config/lanes/_ladder_*.yaml
eval/config/lanes/_evoref_*.yaml

# Local-only build artifacts at the repository root (anchored, so the package
# eval/evaluators/mlflow/ is not caught).
/graphify-out/
/mlflow/

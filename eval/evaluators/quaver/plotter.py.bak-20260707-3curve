"""Quaver evaluator — plot phase.

Renders the surface and upper-air CRPS/spread scorecards as PDFs by patching the
backend q_plot_{sfc,pl}.py templates and running them under the `quaver` binary.

Default deliverable is the **3-curve** comparison — input (coarse op. ENS) ->
ML (downscaled) -> reference (op. IFS-O1280) — for both CRPS *and spread*. The
input baseline is computed by the run phase (see runner.py), so it is always
present for the window and never poisons the fair-mean panels. For the upper-air
spread/skill panel (which the backend template renders for the experiment only),
the input's (and optionally the reference's) spread + ensemble-mean error are
injected explicitly — that is the "spread of input too" view.

If the input baseline could not be resolved/computed (no resolved.prepml.input,
or quaver.three_curve: false), the plotter falls back to the robust
experiment-only scorecards (all reference curves dropped).

Patching handles the gotchas that otherwise produce empty plots:
  * date_step: quaver DateSequence step is in DAYS, not hours.
  * grid: every curve must carry the grid its scores were stored under, or quaver
    matches against its default grid and discards the rows. Surface is stored at
    each model's own grid (input O320, ML/ref O1280); upper-air at 1.5/1.5.
  * fair-mean: a curve with no data for the window wipes the others
    (uniformiseMissingValues). Hence the input baseline is precomputed, and the
    standing reference is gated (quaver.spread_include_reference).

No-op for skipped (manual) runs.
"""
from __future__ import annotations

import json
import logging
import re
import shlex
import subprocess
from pathlib import Path

LOG = logging.getLogger(__name__)

_BACKEND = Path(__file__).resolve().parent.parent.parent / "_backends" / "quaver"
_HOME_QUAVER = Path.home() / "quaver.pdf"
_PL_GRID = "1.5/1.5"  # upper-air scores are computed on the regridded 1.5deg grid

_BLOCK = re.compile(r"list_ml_exp = \{.*\}  ### list ml exps with additional information", re.S)
_BASELINE_APPENDS = (
    'models.append(enfo_o320("pf", s, vend))',
    'models.append(eefo_o96("pf", s, vend))',
    'models_list.append(ifs_curve("pf", s, vend))',
    'models_list.append(eefo_o96_an("pf", s, vend))',
)


def _patch_common(src: str, params: dict, curve_grid: str) -> str:
    """Window, list_ml_exp and experiment-curve-grid patches shared by all modes."""
    label = params["expver"]
    repl = (
        "list_ml_exp = {\n"
        f'    "{label}": "ML {label}",\n'
        "}  ### list ml exps with additional information"
    )
    src, n = _BLOCK.subn(repl, src)
    if n != 1:
        raise RuntimeError(f"quaver plot: failed to patch list_ml_exp block (n={n})")
    src = src.replace("first_reference_date = 20230801", f"first_reference_date = {params['first_reference_date']}", 1)
    src = src.replace("last_reference_date = 20230901", f"last_reference_date = {params['last_reference_date']}", 1)
    src = src.replace("first_lead_time = 24", f"first_lead_time = {params['first_lead_time']}", 1)
    src = src.replace("last_lead_time = 240", f"last_lead_time = {params['last_lead_time']}", 1)
    # DateSequence step is in DAYS, not hours
    src = src.replace("date_step = 24", f"date_step = {max(1, params['date_step'] // 24)}", 1)
    # experiment curve must carry the stored grid
    old = 'vstream=f"prepml_{expver}_{vend}",\n            Class="rd",'
    new = f'vstream=f"prepml_{{expver}}_{{vend}}",\n            grid="{curve_grid}",\n            Class="rd",'
    if src.count(old) == 1:
        src = src.replace(old, new, 1)
    return src


def _input_fn_src(input_params: dict, input_grid: str) -> str:
    """Source for an `input_baseline(...)` curve helper injected into the template."""
    iexpver = input_params["expver"]
    iclass = input_params["class_"]
    istream = input_params.get("stream", "enfo")
    ilabel = f"{istream} {input_params['grid']} input"
    return f'''

def input_baseline(type_, score, vend, suff="", line_style="dotted", line_colour="orange", **kargs):
    return curve(
        data=modeldata(
            vstream="prepml_{iexpver}_%s" % vend,
            grid="{input_grid}",
            Class="{iclass}",
            stream="{istream}",
            type=type_,
            expver="{iexpver}",
            score=score,
            **kargs,
        ),
        legend="{ilabel} %s" % suff,
        line_colour=line_colour,
        line_style=line_style,
    )


'''


def _patch_experiment_only(src: str, params: dict, curve_grid: str) -> str:
    """Fallback: experiment curve only, all reference baselines dropped."""
    src = _patch_common(src, params, curve_grid)
    for anchor in ('levtype="sfc",', 'levtype=t,'):
        if anchor in src:
            src = src.replace(anchor, f'{anchor} grid="{curve_grid}",')
    for bl in _BASELINE_APPENDS:
        src = src.replace(bl, "pass")
    return src


def _patch_threecurve(
    src: str, tag: str, params: dict, input_params: dict, ref_params: dict, include_ref_spread: bool
) -> str:
    """input -> ML -> reference, with input spread injected into the spread panels."""
    ml_grid = params["grid"] if tag == "sfc" else _PL_GRID
    input_grid = input_params["grid"] if tag == "sfc" else _PL_GRID
    ref_label = ref_params["label"]

    src = _patch_common(src, params, ml_grid)
    src = src.replace("def submit_plot(", _input_fn_src(input_params, input_grid) + "def submit_plot(", 1)

    if tag == "sfc":
        # sfc loops fcrps AND spread through the same models list -> input & ref land in both.
        src = src.replace('models.append(enfo_o320("pf", s, vend))', 'models.append(input_baseline("pf", s, vend))')
        src = src.replace('models.append(eefo_o96("pf", s, vend))', 'models.append(ifs_curve_o1280("pf", s, vend))')
        src = src.replace('legend="IFS %s O1280" % suff', f'legend="{ref_label} %s" % suff', 1)
    else:
        # upper-air reference (oper) curve must carry the pl grid
        ref_old = 'vstream="oper_%s" % vend,\n            Class="od",'
        ref_new = f'vstream="oper_%s" % vend,\n            grid="{ref_params["pl_grid"]}",\n            Class="od",'
        src = src.replace(ref_old, ref_new, 1)
        src = src.replace('legend="IFS %s - target/truth" % suff', f'legend="{ref_label} %s" % suff', 1)
        # CRPS panel: swap the o96 input baseline for our resolved input baseline
        src = src.replace(
            'models_list.append(eefo_o96_an("pf", s, vend))',
            'models_list.append(input_baseline("pf", s, vend))',
        )
        # spread/skill panel: the template seeds an empty `models = []` and fills it with
        # the experiment only -> inject input (always) + reference (gated) spread+error.
        seed = (
            "        models = [\n"
            '            input_baseline("pf", "spread", vend, suff="input spread", line_style="dashed")'
            " * (nmem / (nmem - 1)) ** 0.5,\n"
            '            input_baseline("em", "rmsef", vend, suff="input error")'
            " * (nmem / (nmem + 1)) ** 0.5,\n"
        )
        if include_ref_spread:
            seed += (
                f'            ifs_curve("pf", "spread", vend, suff="{ref_label} spread", line_style="dashed")'
                " * (nmem / (nmem - 1)) ** 0.5,\n"
                f'            ifs_curve("em", "rmsef", vend, suff="{ref_label} error")'
                " * (nmem / (nmem + 1)) ** 0.5,\n"
            )
        seed += (
            "        ]\n"
            "        for expver, add_info in experiments.items():\n"
        )
        anchor = "        models = []\n        for expver, add_info in experiments.items():\n"
        if src.count(anchor) != 1:
            raise RuntimeError(
                f"quaver plot: spread-panel anchor not found uniquely (n={src.count(anchor)})"
            )
        src = src.replace(anchor, seed, 1)
    return src


def _render(tag: str, script: Path, params: dict, results_dir: Path, build_src) -> Path | None:
    work = results_dir / f"_q_plot_{tag}.py"
    work.write_text(build_src(script.read_text()))
    plot_dir = results_dir / "plots" / tag
    plot_dir.mkdir(parents=True, exist_ok=True)
    inner = "quaver " + shlex.quote(str(work))
    LOG.info("quaver plot %s: %s (cwd=%s)", tag, inner, plot_dir)
    subprocess.run(["bash", "-lc", f"module load quaver && {inner}"], check=True, cwd=str(plot_dir))
    dst = results_dir / f"quaver_{params['expver']}_{tag}_crps_spread.pdf"
    for cand in (plot_dir / "quaver.pdf", _HOME_QUAVER):
        if cand.exists():
            dst.write_bytes(cand.read_bytes())
            LOG.info("quaver plot %s -> %s", tag, dst)
            return dst
    LOG.warning("quaver plot %s: no quaver.pdf produced", tag)
    return None


def plot(results_dir, lane_config, eval_config, *, output_dir=None, **kwargs):
    results_dir = Path(results_dir)
    eval_config = eval_config or {}
    if (results_dir / "skipped.json").exists():
        LOG.info("quaver: run was skipped (manual) -> no plots.")
        return results_dir
    params_file = results_dir / "params.json"
    if not params_file.exists():
        LOG.warning("quaver plot: params.json missing -> nothing to plot.")
        return results_dir
    params = json.loads(params_file.read_text())

    input_file = results_dir / "input_params.json"
    ref_file = results_dir / "reference_params.json"
    three_curve = eval_config.get("three_curve", True) and input_file.exists()
    include_ref_spread = bool(eval_config.get("spread_include_reference", True))

    if three_curve:
        input_params = json.loads(input_file.read_text())
        ref_params = json.loads(ref_file.read_text()) if ref_file.exists() else {
            "label": "enfo O1280", "pl_grid": _PL_GRID, "grid": "O1280",
        }
        LOG.info("quaver plot: 3-curve mode (input %s -> ML %s -> ref %s)",
                 input_params["grid"], params["grid"], ref_params.get("grid"))
        _render("sfc", _BACKEND / "q_plot_sfc.py", params, results_dir,
                lambda s: _patch_threecurve(s, "sfc", params, input_params, ref_params, include_ref_spread))
        _render("pl", _BACKEND / "q_plot_pl.py", params, results_dir,
                lambda s: _patch_threecurve(s, "pl", params, input_params, ref_params, include_ref_spread))
    else:
        LOG.info("quaver plot: experiment-only mode (no input baseline).")
        _render("sfc", _BACKEND / "q_plot_sfc.py", params, results_dir,
                lambda s: _patch_experiment_only(s, params, params["grid"]))
        _render("pl", _BACKEND / "q_plot_pl.py", params, results_dir,
                lambda s: _patch_experiment_only(s, params, _PL_GRID))
    return results_dir

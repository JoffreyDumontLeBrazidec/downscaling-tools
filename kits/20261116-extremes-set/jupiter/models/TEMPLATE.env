# Model file template of the extremes set XSET-1. Copy to <MODEL>.env (letters, digits, underscore), fill, commit, push.
# Every path is on Jupiter. CK = /e/data1/jureap-data/ecmwf/users/jdumont/outputs and
# DEVR = /e/home/jusers/dumontlebrazidec1/jupiter/dev are set by xset_runs.sh before this file is sourced.
#
# Required
MODEL_NAME=            # run name written in the files (attribute "model")
RUN_DIR=               # directory whose sub-directories hold the exports:
                       #   <RUN_DIR>/*/anemoi-by_step-epoch_*-step_<NNNNNN>.ckpt            (raw by-step file, builds the trainer)
                       #   <RUN_DIR>/*/inference-<EMA_TAG>-anemoi-by_step-epoch_*-step_<NNNNNN>.ckpt   (the weights that are read)
CFG_DIR=               # hydra config directory of the run
CFG_NAME=              # config name (file <CFG_DIR>/<CFG_NAME>.yaml)
CODE_ROOT=             # anemoi-core checkout the run trains with (must be clean and at its pin)
EXPECT_CODE=           # a path fragment of CODE_ROOT that must appear in anemoi.models.__file__ (guards against a wrong import)
CODE_SHA_FILE=         # file holding the full sha of CODE_ROOT
DATASETS_SHA_FILE=     # file holding the full sha of the anemoi-datasets checkout
#
# Optional (defaults in brackets)
# VENV=                # python environment [/e/data1/jureap-data/ecmwf/users/jdumont/venvs/.ds]
# DATASETS_REPO=       # anemoi-datasets checkout [$DEVR/anemoi-datasets-hres-precip-ru]
# EXTRA_OVERRIDES=     # hydra overrides separated by ";" needed to build the GLOBAL model from a training config
#                      # (a run trained on dynamic crops must switch the crops off here; the smoke proves it)
# ANCHOR=              # a case "YYYYMMDD:lead" of the config's TEST split that proves the input paths [20230101:24]
#
# What the predictor needs from the model, checked in every job: the 70 input variables of the global in_lres store in its
# order, the O1280 output grid of the 9 km ensemble rows, and the outputs 10u 10v 2t msl tp BY NAME. More outputs are fine
# (a 12-output model with z_500 and t_850 is read unchanged); they are not written.

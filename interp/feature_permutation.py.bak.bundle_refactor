"""Feature permutation importance for AIFSDD.

Shuffle each input variable independently and measure output degradation.
No gradients, no hooks — just forward passes with permuted inputs.
Stratified by sigma level.

Usage
-----
    cd ~/dev/downscaling-tools
    python -m interp.feature_permutation \
        --checkpoint /path/to/checkpoint.ckpt \
        --output-dir /path/to/results/ \
        --n-repeats 5 \
        --sigmas 0.1 1.0 5.0 20.0 80.0
"""

from __future__ import annotations

import argparse
import json
import logging
import sys
from pathlib import Path

import numpy as np
import torch

_DT_ROOT = Path(__file__).resolve().parent.parent
if str(_DT_ROOT) not in sys.path:
    sys.path.insert(0, str(_DT_ROOT))

from interp.model_utils import (
    load_model,
    get_variable_names,
    prepare_batch,
    denoise_at_sigma,
    get_surface_target_indices,
    per_target_mse,
)
from interp.regions import (
    build_region_mask,
    get_hres_lat_lon,
    get_area_weights,
    masked_area_mean,
)

LOGGER = logging.getLogger(__name__)


def compute_permutation_importance(
    bundle,
    prepared: dict,
    sigma: float,
    n_repeats: int = 5,
    var_names_lres: dict | None = None,
    var_names_hres: dict | None = None,
    region_masks: dict | None = None,
    area_weights=None,
) -> dict:
    """Compute permutation importance for each input variable at a given sigma.

    Permutes each variable across the batch dimension and measures how much
    the denoised output changes relative to the un-permuted baseline.
    """
    x_interp = prepared["x_interp"]
    x_hres = prepared["x_hres"]
    y_residual = prepared["y_residual"]

    batch_size = x_interp.shape[0]
    if batch_size < 2:
        raise ValueError(
            f"Need batch_size >= 2 for permutation, got {batch_size}. "
            "Increase --n-batches or use a larger validation set."
        )

    target_indices = get_surface_target_indices(bundle)
    LOGGER.info("Surface targets being tracked: %s", target_indices)

    # Fixed noise for reproducibility within this sigma
    noise = torch.randn_like(y_residual)

    # Baseline (paired with each repeat so we measure delta-vs-baseline at fixed noise)
    baseline_out = denoise_at_sigma(bundle, x_interp, x_hres, y_residual, sigma, noise=noise)
    y_clean = y_residual[..., : baseline_out.shape[-1]]
    baseline_target_mse = per_target_mse(baseline_out, y_clean, target_indices)
    baseline_agg_mse = ((baseline_out - y_clean) ** 2).mean().item()
    # Per-region per-target baseline MSE (paired to clean target, area-weighted)
    baseline_region_target_mse = {}
    if region_masks:
        for rname, rmask in region_masks.items():
            baseline_region_target_mse[rname] = {}
            for tname, tidx in target_indices.items():
                per_cell = ((baseline_out[..., tidx] - y_clean[..., tidx]) ** 2)
                grid = per_cell.reshape(-1, per_cell.shape[-1]).mean(dim=0)
                baseline_region_target_mse[rname][tname] = float(
                    masked_area_mean(grid, rmask, area_weights)
                )

    results = {
        "sigma": sigma,
        "surface_targets": list(target_indices.keys()),
        "regions": list(region_masks.keys()) if region_masks else [],
        "baseline_mse_aggregate": baseline_agg_mse,
        "baseline_mse_per_target": baseline_target_mse,
        "baseline_region_per_target_mse": baseline_region_target_mse,
        "lres_importance": {},
        "hres_importance": {},
    }

    n_lres_vars = x_interp.shape[-1]
    n_hres_vars = x_hres.shape[-1]

    def _record_perm(perm_out, mses_agg, mses_per_target_paired, mses_region_per_target_paired):
        # MSE vs the paired baseline (computed with the same noise & same input)
        # paired delta-vs-baseline is the cleaner signal because shared noise cancels
        diff_to_target = (perm_out - y_clean) ** 2
        mses_agg.append(diff_to_target.mean().item())
        paired = {}
        region_paired = {}
        for name, idx in target_indices.items():
            d_paired_grid = (perm_out[..., idx] - baseline_out[..., idx]) ** 2  # (B,T,E,G)
            paired[name] = float(d_paired_grid.mean().item())
            if region_masks:
                grid = d_paired_grid.reshape(-1, d_paired_grid.shape[-1]).mean(dim=0)  # (G,)
                for rname, rmask in region_masks.items():
                    region_paired.setdefault(rname, {})[name] = float(
                        masked_area_mean(grid, rmask, area_weights)
                    )
        mses_per_target_paired.append(paired)
        mses_region_per_target_paired.append(region_paired)

    # Permute low-res conditioning variables
    for var_idx in range(n_lres_vars):
        mses_agg = []
        mses_paired = []
        mses_region_paired = []
        for _ in range(n_repeats):
            x_perm = x_interp.clone()
            perm = torch.randperm(batch_size, device=x_interp.device)
            x_perm[..., var_idx] = x_interp[perm][..., var_idx]
            perm_out = denoise_at_sigma(bundle, x_perm, x_hres, y_residual, sigma, noise=noise)
            _record_perm(perm_out, mses_agg, mses_paired, mses_region_paired)
        var_name = var_names_lres.get(var_idx, f"lres_{var_idx}") if var_names_lres else f"lres_{var_idx}"
        per_target_paired_mean = {
            name: float(np.mean([m[name] for m in mses_paired])) for name in target_indices
        }
        per_target_paired_std = {
            name: float(np.std([m[name] for m in mses_paired])) for name in target_indices
        }
        region_per_target_paired_mean = {}
        if region_masks:
            for rname in region_masks:
                region_per_target_paired_mean[rname] = {
                    name: float(np.mean([m[rname][name] for m in mses_region_paired]))
                    for name in target_indices
                }
        results["lres_importance"][str(var_idx)] = {
            "name": var_name,
            "mean_mse_aggregate": float(np.mean(mses_agg)),
            "std_mse_aggregate": float(np.std(mses_agg)),
            "importance_ratio_aggregate": float(np.mean(mses_agg) / max(baseline_agg_mse, 1e-10)),
            "paired_mse_per_target": per_target_paired_mean,
            "paired_mse_per_target_std": per_target_paired_std,
            "region_paired_mse_per_target": region_per_target_paired_mean,
        }

    # Permute high-res forcing variables
    for var_idx in range(n_hres_vars):
        mses_agg = []
        mses_paired = []
        mses_region_paired = []
        for _ in range(n_repeats):
            x_perm = x_hres.clone()
            perm = torch.randperm(batch_size, device=x_hres.device)
            x_perm[..., var_idx] = x_hres[perm][..., var_idx]
            perm_out = denoise_at_sigma(bundle, x_interp, x_perm, y_residual, sigma, noise=noise)
            _record_perm(perm_out, mses_agg, mses_paired, mses_region_paired)
        var_name = var_names_hres.get(var_idx, f"hres_{var_idx}") if var_names_hres else f"hres_{var_idx}"
        per_target_paired_mean = {
            name: float(np.mean([m[name] for m in mses_paired])) for name in target_indices
        }
        per_target_paired_std = {
            name: float(np.std([m[name] for m in mses_paired])) for name in target_indices
        }
        region_per_target_paired_mean = {}
        if region_masks:
            for rname in region_masks:
                region_per_target_paired_mean[rname] = {
                    name: float(np.mean([m[rname][name] for m in mses_region_paired]))
                    for name in target_indices
                }
        results["hres_importance"][str(var_idx)] = {
            "name": var_name,
            "mean_mse_aggregate": float(np.mean(mses_agg)),
            "std_mse_aggregate": float(np.std(mses_agg)),
            "importance_ratio_aggregate": float(np.mean(mses_agg) / max(baseline_agg_mse, 1e-10)),
            "paired_mse_per_target": per_target_paired_mean,
            "paired_mse_per_target_std": per_target_paired_std,
            "region_paired_mse_per_target": region_per_target_paired_mean,
        }

    return results


def run_permutation_study(
    checkpoint_path: str,
    output_dir: str,
    sigmas: list[float] | None = None,
    n_repeats: int = 5,
    n_batches: int = 4,
    device: str = "cuda",
    precision: str = "bf16",
    regions: list[str] | None = None,
):
    """Run full permutation importance study across sigma levels."""
    if sigmas is None:
        sigmas = [0.1, 1.0, 5.0, 20.0, 80.0]

    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)

    LOGGER.info("Loading model from %s", checkpoint_path)
    bundle = load_model(checkpoint_path, device=device, precision=precision)
    var_names = get_variable_names(bundle)

    LOGGER.info("Getting validation data...")
    bundle.datamodule.setup(stage="predict")
    dl = bundle.datamodule.val_dataloader()

    # Collect batches
    batches = []
    for i, batch in enumerate(dl):
        if i >= n_batches:
            break
        batches.append(batch)
    LOGGER.info("Collected %d batches", len(batches))

    # Stack into a single batch for permutation (need batch_size > 1)
    x_lres_all = torch.cat([b[0] for b in batches], dim=0)
    x_hres_all = torch.cat([b[1] for b in batches], dim=0)
    y_all = torch.cat([b[2] for b in batches], dim=0)
    LOGGER.info("Stacked batch shapes: lres=%s, hres=%s, y=%s",
                x_lres_all.shape, x_hres_all.shape, y_all.shape)

    # Prepare batch (interpolation, preprocessing, residuals)
    prepared = prepare_batch(bundle, x_lres_all, x_hres_all, y_all)

    # Region masks + area weights (resolved once, reused across sigmas).
    if regions is None:
        regions = ["amazon_rainforest"]
    lat, lon = get_hres_lat_lon(bundle)
    lat_t = torch.as_tensor(lat); lon_t = torch.as_tensor(lon)
    region_masks = {r: build_region_mask(lat_t, lon_t, r) for r in regions}
    area_weights = get_area_weights(lat_t, bundle)
    LOGGER.info("Regions: %s", {r: int(m.sum()) for r, m in region_masks.items()})

    all_results = {
        "checkpoint": checkpoint_path,
        "n_batches": len(batches),
        "batch_size": x_lres_all.shape[0],
        "regions": regions,
        "sigma_results": [],
    }

    for sigma in sigmas:
        LOGGER.info("Computing permutation importance at sigma=%.2f", sigma)
        result = compute_permutation_importance(
            bundle,
            prepared,
            sigma=sigma,
            n_repeats=n_repeats,
            var_names_lres=var_names.get("input_lres"),
            var_names_hres=var_names.get("input_hres"),
            region_masks=region_masks,
            area_weights=area_weights,
        )
        all_results["sigma_results"].append(result)

    # Save
    results_file = output_path / "permutation_importance.json"
    with open(results_file, "w") as f:
        json.dump(all_results, f, indent=2)
    LOGGER.info("Results saved to %s", results_file)

    # Print summary
    _print_summary(all_results)
    return all_results


def _print_summary(all_results: dict):
    print("\n" + "=" * 70)
    print("FEATURE PERMUTATION IMPORTANCE — per-surface-target paired-MSE")
    print("=" * 70)
    for res in all_results["sigma_results"]:
        sigma = res["sigma"]
        targets = res["surface_targets"]
        print(f"\nSigma = {sigma:.2f} (baseline aggregate MSE = {res['baseline_mse_aggregate']:.4e})")
        print("Baseline per-target MSE (to clean target):")
        for t in targets:
            print(f"    {t:>5}: {res['baseline_mse_per_target'][t]:.4e}")
        # For each surface target, print top-10 lres variables by paired MSE
        for target in targets:
            ranked = sorted(
                res["lres_importance"].items(),
                key=lambda x: x[1]["paired_mse_per_target"][target],
                reverse=True,
            )
            print(f"\n  Top-10 lres for target {target}:")
            for i, (var_idx, info) in enumerate(ranked[:10]):
                print(f"    {i+1:2d}. {info['name']:30s}  paired_mse={info['paired_mse_per_target'][target]:.4e}")
            # Same for hres
            ranked_h = sorted(
                res["hres_importance"].items(),
                key=lambda x: x[1]["paired_mse_per_target"][target],
                reverse=True,
            )
            if ranked_h:
                print(f"  Top-5 hres for target {target}:")
                for i, (var_idx, info) in enumerate(ranked_h[:5]):
                    print(f"    {i+1:2d}. {info['name']:30s}  paired_mse={info['paired_mse_per_target'][target]:.4e}")


def main():
    parser = argparse.ArgumentParser(
        description="Feature permutation importance for AIFSDD",
    )
    parser.add_argument("--checkpoint", required=True, help="Path to training checkpoint")
    parser.add_argument("--output-dir", required=True, help="Output directory")
    parser.add_argument("--sigmas", nargs="+", type=float,
                        default=[0.1, 1.0, 5.0, 20.0, 80.0])
    parser.add_argument("--n-repeats", type=int, default=5)
    parser.add_argument("--n-batches", type=int, default=4)
    parser.add_argument("--device", default="cuda", choices=["cuda", "cpu"])
    parser.add_argument("--precision", default="bf16", choices=["fp32", "fp16", "bf16"])
    parser.add_argument("--region", action="append", default=None,
                        help="Region spec; repeatable. 'global', 'amazon', 'tropics', "
                             "or 'bbox:latmin,latmax,lonmin,lonmax'. Default: global,amazon,tropics.")
    args = parser.parse_args()

    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")

    run_permutation_study(
        checkpoint_path=args.checkpoint,
        output_dir=args.output_dir,
        sigmas=args.sigmas,
        regions=args.region,
        n_repeats=args.n_repeats,
        n_batches=args.n_batches,
        device=args.device,
        precision=args.precision,
    )


if __name__ == "__main__":
    main()
